{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "true",
    "check": "npm run format:check && npm run type:check && npm run lint:check",
    "fix": "npm run lint:fix && npm run format:fix",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:check": "knip && eslint --max-warnings=0 .",
    "lint:fix": "knip --fix && npm install && eslint --fix",
    "prepare": "is-ci || husky",
    "test": "true",
    "type:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jiti": "^2.7.0",
    "knip": "^6.44.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
