{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "author": "Simon Hochholzer <simon@symmetronic.com>",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./*"
  },
  "scripts": {
    "audit:check": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "build": "true",
    "check": "npm run format:check && npm run type:check && npm run lint:check && npm run license:check",
    "fix": "npm run lint:fix; npm run format:fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "license:check": "license-checker-rseidelsohn --excludePrivatePackages --summary --onlyAllow \"0BSD;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BlueOak-1.0.0;CC-BY-3.0;CC-BY-4.0;CC0-1.0;ISC;MIT;Python-2.0;Unlicense;Zlib\"",
    "lint:check": "knip && eslint --max-warnings=0 .",
    "lint:fix": "knip --fix; npm install && eslint --fix .",
    "prepare": "husky",
    "test": "node --test \"tests/specs/**/*.spec.ts\"",
    "type:check": "tsc --noEmit",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.44.1",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
