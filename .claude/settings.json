{
  "autoMemoryEnabled": false,
  "enabledMcpjsonServers": ["chrome-devtools"],
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "deny": ["Read(//**/.env)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env-files.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__chrome-devtools__(navigate_page|new_page)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/restrict-browser-to-localhost.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
            "timeout": 300,
            "statusMessage": "Running npm run verify"
          }
        ]
      }
    ]
  }
}
